# Copy to .env.local for local development. Never commit real .env files.
# Both values are public by design (the anon key is safe to ship to browsers).
# Leave them empty to run fully offline: the app must work without them.
# NEVER put the Supabase service-role key here or anywhere in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
